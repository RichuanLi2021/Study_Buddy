{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "@/*": ["./*"],
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "resources/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
, "components/auth/toast/toast_message"  ],
  "exclude": ["node_modules", "**/*.spec.ts"]
}